NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Business/contact details shown on /contact, /privacy, /terms, /refund-policy (Razorpay and Google Play check these)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_JURISDICTION_CITY=

# Google Play app (Trusted Web Activity) verification, served at /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# Phone reminders (web push) and the daily reminder job (vercel.json cron, 09:00 India time)
# Generate keys once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random string; Vercel sends it to the cron job automatically
CRON_SECRET=
# Supabase > Project Settings > API keys > service_role (secret, server only, never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
